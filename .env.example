# Use os MESMOS valores do projeto Supabase do sir-barbecue (mesmos do EXPO_PUBLIC_* do mobile).
VITE_SUPABASE_URL=https://SEUPROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# true = usa dados MOCK (sem backend); false/ausente = usa o Supabase real.
VITE_USE_MOCK=true

# Endpoint público de saúde (Edge Function `saude`). Sem isto, o card de saúde usa mock.
# A origem deste painel precisa estar em ALLOWED_ORIGIN nos secrets da função, senão o
# navegador bloqueia por CORS.
VITE_SAUDE_URL=https://SEUPROJETO.supabase.co/functions/v1/saude
